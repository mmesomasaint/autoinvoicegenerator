# ================================================
# AutoInvoiceGeneration Environment Configuration
# ================================================

# Application Setup
PROJECT_NAME="InvoiceForge Microservice"
ENVIRONMENT="development"
API_KEY="dev_secret_api_key_12345"

# Database Configuration
# - Local SQLite (Dev): sqlite+aiosqlite:///./dev_invoices.db
# - PostgreSQL/Supabase (Docker/Prod): postgresql+asyncpg://postgres:postgres@db:5432/invoicedb
DATABASE_URL="sqlite+aiosqlite:///./dev_invoices.db"

# Email / SMTP Settings
# - Local Dev (DebuggingServer): localhost:1025
# - Mailpit (Docker Dev): mailpit:1025
# - Production: smtp.sendgrid.net (or AWS SES)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="billing@company.com"

# Storage Configuration
STORAGE_DIR="storage/invoices"
